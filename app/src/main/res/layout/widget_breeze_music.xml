<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="0dp">

    <ImageView
        android:id="@+id/widget_canvas_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/music_widget_label"
        android:scaleType="fitXY" />

    <!-- Transparent interactive zones matching the 800x800 canvas weight grid (18 / 44 / 20 / 18) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="100">

        <!-- Band 1 (0..144px): Top Header (Mini Art + Title/Artist on left, Expand/Mode buttons on right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="18"
            android:orientation="horizontal"
            android:weightSum="100">

            <FrameLayout
                android:id="@+id/btn_open_app"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="68"
                android:background="@android:color/transparent" />

            <FrameLayout
                android:id="@+id/btn_toggle_lyrics"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="32"
                android:background="@android:color/transparent" />
        </LinearLayout>

        <!-- Band 2 (144..496px): Center Floating Transport Controls (Prev / Play-Pause / Next) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="44"
            android:orientation="horizontal"
            android:weightSum="100">

            <FrameLayout
                android:id="@+id/btn_prev"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="33"
                android:background="@android:color/transparent" />

            <FrameLayout
                android:id="@+id/btn_play_pause"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="34"
                android:background="@android:color/transparent" />

            <FrameLayout
                android:id="@+id/btn_next"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="33"
                android:background="@android:color/transparent" />
        </LinearLayout>

        <!-- Band 3 (496..656px): Synced Lyrics & Poster Expand Chevron Area -->
        <FrameLayout
            android:id="@+id/btn_lyrics_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="20"
            android:background="@android:color/transparent" />

        <!-- Band 4 (656..800px): Bottom Timeline Area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="18" />
    </LinearLayout>
</FrameLayout>
